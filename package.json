{
  "name": "jedencode",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt typecheck && nuxt build",
    "start": "node .output/server/index.mjs",
    "type-check": "nuxt typecheck",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && node scripts/deploy-ssr.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "normalize.css": "^8.0.1",
    "nuxt": "^4.6.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@types/node": "^26.6.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  },
  "type": "module",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "arrowParens": "avoid"
  }
}
