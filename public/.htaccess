# Deny access to dotfiles (.ftp-deploy-sync-state.json, .envrc, ...)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Pages are pre-rendered by `nuxt generate` (/index.html, /some/page/index.html).
# Unknown URLs get a real 404 status; 404.html boots the app, which shows the not-found page.
ErrorDocument 404 /404.html

# Caching: hashed assets forever, HTML always revalidated
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  <If "%{REQUEST_URI} =~ m#^/_nuxt/#">
    ExpiresDefault "access plus 1 year"
  </If>
</IfModule>
